# Production Environment Variables
# Copy this file to .env.production and update with your actual values

# Node Environment
NODE_ENV=production
PORT=3000

# PgBouncer PostgreSQL Connection (use sslmode=disable for PgBouncer)
DATABASE_URL=postgresql://postgres:*****@127.0.0.1:6432/gameschakra?sslmode=disable

# Session Security
SESSION_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
SESSION_COOKIE_NAME=gc_sid
COOKIE_DOMAIN=.gameschakra.com

# CORS Configuration for Production
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# File Upload Settings
MAX_FILE_SIZE=50000000

# Logging
LOG_LEVEL=info